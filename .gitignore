# 비밀값 — 접속 정보는 .env 에만 둔다(TRD 9.3). 예시는 deploy/env.example
.env
.env.*
!deploy/env.example

# Python / uv
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.import_linter_cache/
*.egg-info/
build/
dist/

# 프론트
node_modules/
frontend/dist/
frontend/dist-deploy/
frontend/dist-devconsole/

# 오프라인 번들 산출물
deploy/offline/out/

# 편집기
.idea/
.vscode/
*.swp
*.tsbuildinfo

# 개발 로그·가짜 발송 게이트웨이 출력(config/notify.dev.yaml)
logs/

# 개발 콘솔 기록(작업·서비스 로그, ADR-0015)
.devconsole/

# Playwright MCP 작업 파일(화면 확인 캡처·콘솔 기록)
.playwright-mcp/
