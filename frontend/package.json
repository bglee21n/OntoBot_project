{
  "name": "ontobot-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:deploy": "vite --config vite.deploy.config.ts",
    "dev:devconsole": "vite --config vite.devconsole.config.ts",
    "build": "tsc -b && vite build",
    "build:deploy": "tsc -b && vite build --config vite.deploy.config.ts",
    "build:devconsole": "tsc -b && vite build --config vite.devconsole.config.ts",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "preview": "vite preview",
    "gen:api": "openapi-typescript src/api/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4"
  }
}
