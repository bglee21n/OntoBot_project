# OntoBot 앱 설정(api·worker 에만 들어간다) — 설치 때 $ONTOBOT_HOME/app.env 로 복사된다(600).
# 접속 정보(DB·Neo4j 비밀번호)는 여기 적지 않는다 — ontobotctl 이 .env 에서 넘긴다.
# 바꾼 뒤: cd /opt/ontobot && docker compose up -d   (또는 배포 콘솔의 '앱 재시작')

ONTOBOT_ENV=prod

# 등급 ②(일부 근거) 허용 여부
ONTOBOT_GRADE2_ENABLED=true

# 인증 — 로컬 계정과 세션
ONTOBOT_LOCAL_AUTH_ENABLED=true
ONTOBOT_SESSION_TTL_HOURS=8
# HTTPS(앞단 프록시)를 쓰면 반드시 true, ALLOWED_ORIGINS 에 https 주소
ONTOBOT_COOKIE_SECURE=false
ONTOBOT_ALLOWED_ORIGINS=["http://localhost:8000"]

# 사내 SSO(OIDC). ISSUER 를 비우면 꺼진다.
ONTOBOT_OIDC_ISSUER=
ONTOBOT_OIDC_CLIENT_ID=
ONTOBOT_OIDC_CLIENT_SECRET=
ONTOBOT_OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
ONTOBOT_OIDC_DEFAULT_ROLES=["user"]
# 운영은 API 가 프론트를 같은 오리진에서 서빙한다(비워 둔다).
ONTOBOT_FRONTEND_BASE_URL=

# 보존 기간(일, 0 = 지우지 않음). 감사 로그는 지우지 않는다.
ONTOBOT_RETENTION_TRACE_DAYS=90
ONTOBOT_RETENTION_MESSAGE_DAYS=365
ONTOBOT_RETENTION_UTTERANCE_DAYS=180

# DB 연결 풀 — 합이 동시 채팅 상한(ADR-0011)
ONTOBOT_DB_POOL_SIZE=20
ONTOBOT_DB_MAX_OVERFLOW=10

# 데이터 소스 접속(원천마다 PREFIX_HOST·_PORT·_DB·_USER·_PASSWORD) — 화면의 시크릿 참조 env:PREFIX
# ONTOBOT_SRC_FAC_HOST=10.0.0.15
# 메일·SMS 게이트웨이 비밀값(config/notify.yaml 의 *_env 가 가리키는 이름)
# ONTOBOT_SMTP_PASSWORD=
# 관리 화면의 '배포 콘솔' 링크
ONTOBOT_DEPLOYER_URL=http://localhost:8100
