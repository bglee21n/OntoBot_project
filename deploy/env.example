# 이 파일을 저장소 루트의 .env 로 복사해 값을 채운다. .env 는 커밋하지 않는다.
# 백엔드(ontobot.config)와 docker compose 가 같은 파일을 읽는다.

ONTOBOT_ENV=dev

# PostgreSQL — 기록의 원본
ONTOBOT_DB_HOST=localhost
ONTOBOT_DB_PORT=5432
ONTOBOT_DB_NAME=ontobot_db
ONTOBOT_DB_USER=ontobot
ONTOBOT_DB_PASSWORD=change-me

# Neo4j — 링크 투영 (Phase 2부터 사용)
ONTOBOT_NEO4J_URI=bolt://localhost:7687
ONTOBOT_NEO4J_USER=neo4j
ONTOBOT_NEO4J_PASSWORD=change-me

# 등급 ②(일부 근거) 허용 여부
ONTOBOT_GRADE2_ENABLED=true
