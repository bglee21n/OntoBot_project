# 이 파일을 저장소 루트의 .env 로 복사해 값을 채운다. .env 는 커밋하지 않는다.
# 백엔드(ontobot.config)와 설치 스크립트(deploy/windows)가 같은 파일을 읽는다.

ONTOBOT_ENV=dev

# PostgreSQL — 기록의 원본
ONTOBOT_DB_HOST=localhost
ONTOBOT_DB_PORT=5432
ONTOBOT_DB_NAME=ontobot_db
ONTOBOT_DB_USER=ontobot
ONTOBOT_DB_PASSWORD=change-me
# 연결 풀(프로세스당). 채팅 한 건이 답이 끝날 때까지 연결 하나를 쥐므로 이 합이 API 의 동시 채팅 상한이다(ADR-0011).
ONTOBOT_DB_POOL_SIZE=20
ONTOBOT_DB_MAX_OVERFLOW=10

# Neo4j — 링크 투영 (Phase 2부터 사용)
ONTOBOT_NEO4J_URI=bolt://localhost:7687
ONTOBOT_NEO4J_USER=neo4j
ONTOBOT_NEO4J_PASSWORD=change-me

# 통합 테스트 전용 Neo4j 인스턴스 — 테스트가 그래프를 비운다. 개발용과 섞지 말 것(ADR-0007).
ONTOBOT_TEST_NEO4J_URI=bolt://localhost:7688
ONTOBOT_TEST_NEO4J_USER=neo4j
ONTOBOT_TEST_NEO4J_PASSWORD=change-me

# 등급 ②(일부 근거) 허용 여부
ONTOBOT_GRADE2_ENABLED=true

# 폐쇄망 배포(기본 true). true 면 외부 서버를 부르는 화면 기능(음성 입력)은 아래 설정과 상관없이 꺼진다(TRD 17.1 결정 13)
ONTOBOT_CLOSED_NETWORK=true
# 워크숍 음성 입력(브라우저 음성 인식 — 음성이 브라우저 공급자 서버로 간다). 폐쇄망이 아닐 때만 효과가 있다
ONTOBOT_VOICE_INPUT=false

# 인증 — 로컬 계정(폐쇄망·개발용, 운영에서 false 가능)과 세션
ONTOBOT_LOCAL_AUTH_ENABLED=true
ONTOBOT_SESSION_TTL_HOURS=8
# 운영(HTTPS)에서는 반드시 true
ONTOBOT_COOKIE_SECURE=false
ONTOBOT_ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:8000"]

# OIDC(Authorization Code + PKCE). ISSUER 를 비우면 꺼진다.
ONTOBOT_OIDC_ISSUER=
ONTOBOT_OIDC_CLIENT_ID=
ONTOBOT_OIDC_CLIENT_SECRET=
ONTOBOT_OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
ONTOBOT_OIDC_DEFAULT_ROLES=["user"]
# 로그인 뒤 돌아갈 화면 오리진(개발: Vite). 운영에서 백엔드가 프론트를 서빙하면 비운다.
ONTOBOT_FRONTEND_BASE_URL=http://localhost:5173
# 설치본: API 가 프론트 빌드 산출물을 같은 오리진에서 서빙한다(앱 이미지가 채운다). 개발은 비운다.
ONTOBOT_FRONTEND_DIST=
# 로그 파일 폴더(JSON 한 줄, 크기 회전). 비우면 표준 출력만.
ONTOBOT_LOG_DIR=

# Action 알림의 메일·SMS 게이트웨이 설정 파일(TRD 17.1-4). 비우면 저장소의 config/notify.yaml(채널 꺼짐).
# 설치본(컨테이너)은 compose 가 /app/config/notify.yaml 로 채운다. 개발 PC 는 config/notify.dev.yaml(가짜 게이트웨이).
# ONTOBOT_NOTIFY_CONFIG_PATH=
