<!-- WinSW 2.12 서비스 설정(ADR-0010). install.ps1 이 {{…}} 를 채워 services\ 에 둔다. -->
<service>
  <id>ontobot-worker</id>
  <name>OntoBot Worker</name>
  <description>OntoBot 워커 — 동기화·그래프 투영·주기 작업(매일 대사·보존 기간)·평가 실행</description>
  <executable>{{ROOT}}\current\backend\.venv\Scripts\python.exe</executable>
  <arguments>-m ontobot.jobs.worker</arguments>
  <workingdirectory>{{ROOT}}\current\backend</workingdirectory>
  <env name="PYTHONUTF8" value="1"/>
  <depend>{{PG_SERVICE}}</depend>
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="30 sec"/>
  <resetfailure>1 hour</resetfailure>
  <!-- 워커는 Ctrl+C(SIGINT)를 받으면 지금 작업을 마치고 멈춘다. 평가 실행은 길 수 있다. -->
  <stoptimeout>120 sec</stoptimeout>
  <logpath>{{ROOT}}\logs\service</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>5</keepFiles>
  </log>
</service>
