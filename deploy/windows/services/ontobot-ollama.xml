<!-- WinSW 2.12 서비스 설정(ADR-0010). Ollama 독립 실행본을 사용자 트레이 앱이 아닌 서비스로 돌린다. -->
<service>
  <id>ontobot-ollama</id>
  <name>OntoBot Ollama</name>
  <description>로컬 LLM(Ollama) — localhost 에서만 받는다</description>
  <executable>{{ROOT}}\ollama\ollama.exe</executable>
  <arguments>serve</arguments>
  <workingdirectory>{{ROOT}}\ollama</workingdirectory>
  <env name="OLLAMA_HOST" value="127.0.0.1:11434"/>
  <env name="OLLAMA_MODELS" value="{{ROOT}}\ollama-models"/>
  <!-- 폐쇄망: 모델은 번들로만 들어온다. 시작할 때 목록에 없는 조각을 지우지 않게 한다. -->
  <env name="OLLAMA_NOPRUNE" value="1"/>
  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="10 sec"/>
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>30 sec</stoptimeout>
  <logpath>{{ROOT}}\logs\service</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>5</keepFiles>
  </log>
</service>
